{
    "name": "wp-openrag/wp-openrag",
    "description": "WP OpenRag - RAG chatbot WordPress plugin with embeddings, knowledge base, MCP integration, and multi-provider support.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.0",
        "smalot/pdfparser": "^2.12",
        "woocommerce/action-scheduler": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "WPOpenRag\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}

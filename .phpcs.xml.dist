<?xml version="1.0"?>
<ruleset name="ItihRag AI Chatbot">
	<description>WordPress.org directory standards. Run: phpcs -p --extensions=php .</description>

	<rule ref="WordPress-Core">
		<property name="text_domain" type="array" value="itih-ai-chatbot"/>
		<property name="prefixes" type="array" value="itih_,ItihRag,ITIH"/>
	</rule>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/dist/</exclude-pattern>
	<exclude-pattern>*/.omo/*</exclude-pattern>
</ruleset>
